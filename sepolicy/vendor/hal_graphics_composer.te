binder_call(hal_graphics_composer_default, vendor_hal_displayfeature_xiaomi_default)

hal_attribute_service(hal_graphics_composer, vendor_hal_hwcextension_xiaomi_service)

add_service(hal_graphics_composer_default, vendor_miclstc_service)
add_service(hal_graphics_composer_default, vendor_mistcdisplay_service)

hal_client_domain(hal_graphics_composer_default, vendor_hal_displayfeature_xiaomi)

allow hal_graphics_composer_default vendor_displayfeature_device:chr_file r_file_perms;
allow hal_graphics_composer_default vendor_sysfs_displayfeature:dir r_dir_perms;
allow hal_graphics_composer_default vendor_sysfs_displayfeature:file rw_file_perms;

get_prop(hal_graphics_composer_default, boot_status_prop)
set_prop(hal_graphics_composer_default, vendor_display_prop)
