type thermal_profiles_app, domain, coredomain, mlstrustedsubject;

app_domain(thermal_profiles_app)

allow thermal_profiles_app app_api_service:service_manager find;
allow thermal_profiles_app sysfs_thermal:dir r_dir_perms;
allow thermal_profiles_app sysfs_thermal:file rw_file_perms;
allow thermal_profiles_app sysfs_thermal:lnk_file read;
allow thermal_profiles_app system_app_data_file:dir create_dir_perms;
allow thermal_profiles_app system_app_data_file:file create_file_perms;
