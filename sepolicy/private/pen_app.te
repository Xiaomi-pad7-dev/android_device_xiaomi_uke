type pen_app, domain, coredomain;

app_domain(pen_app)
bluetooth_domain(pen_app)

allow pen_app self:netlink_kobject_uevent_socket { create read setopt bind };

allow pen_app app_api_service:service_manager find;

# The pen hall state is delivered via the netlink uevent (POWER_SUPPLY_PEN_HALL3).
# Note: reading the sysfs nodes directly is impossible from this coredomain
# app - /sys/class/qcom-battery/* is vendor-labeled (vendor_sysfs_battery_supply,
# unreachable from system policy) and the generic `sysfs` type is banned by
# `neverallow coredomain sysfs:file no_rw_file_perms`.

set_prop(pen_app, system_pen_prop)

# Talk to the stock touch feature AIDL HAL (own process) from the pen app.
binder_call(pen_app, hal_touchfeature_xiaomi_default)
allow pen_app hal_touchfeature_xiaomi_service:service_manager find;
