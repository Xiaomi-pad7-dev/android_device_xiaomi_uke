type pen_app, domain, coredomain, mlstrustedsubject;

app_domain(pen_app)
binder_call(pen_app, hal_touchfeature_xiaomi_default)

allow pen_app activity_service:service_manager find;
allow pen_app bluetooth_manager_service:service_manager find;
allow pen_app hal_touchfeature_xiaomi_service:service_manager find;
allow pen_app hidraw_device:chr_file r_file_perms;
allow pen_app input_service:service_manager find;
allow pen_app self:netlink_kobject_uevent_socket { bind create getopt read setopt };
allow pen_app sysfs:dir r_dir_perms;
allow pen_app sysfs:lnk_file read;
allow pen_app system_app_data_file:dir create_dir_perms;
allow pen_app system_app_data_file:file create_file_perms;
