# Xiaomi Focus Pen Pro keyboard character map.
#
# The four pen gestures are mapped to the gamepad button range in the
# matching .kl file so that apps can distinguish them. This map keeps those
# buttons character-less, exactly like the stock HyperOS file
# (/system_ext/usr/keychars/Vendor_0022_Product_5081.kcm), so no digits or
# newlines ever land in a text field while gesturing.

type FULL

key BUTTON_7 {
    base:                               none
}

key BUTTON_8 {
    base:                               none
}

key BUTTON_9 {
    base:                               none
}

key BUTTON_10 {
    base:                               none
}
