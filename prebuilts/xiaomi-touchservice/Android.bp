android_app_import {
    name: "XiaomiTouchService",
    apk: "TouchService.apk",
    certificate: "platform",
    privileged: true,
    system_ext_specific: true,

    // The APK ships classes2.dex holding the MIUI stubs the service resolves
    // reflectively (miui.os.HyperOSCustFeatureResolve, miui.os.Build,
    // miui.hardware.input.MiuiInputManager). Keep the dex as-is.
    dex_preopt: {
        enabled: false,
    },
}
